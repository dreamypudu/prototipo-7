# Copia este archivo a `.env.production` y completa los valores.
# Nunca commitees el .env.production con credenciales reales.

# URL completa de Postgres. Si sigues con Supabase, dejala apuntando alli.
# Si migras a Postgres local, sera algo como: postgresql://compass:CLAVE@db:5432/compass
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Dominios permitidos por CORS, separados por coma. Sin slash final.
ALLOWED_ORIGINS=https://compass.giia.udec.cl

# URL que el frontend usa para hablar con el backend.
# Si front y back comparten dominio (recomendado), deja /api (ruta relativa).
# Si quedan en subdominios distintos: https://api.compass.giia.udec.cl
VITE_API_URL=/api

# --- Solo si usas el servicio `db` opcional del docker-compose.yml ---
# POSTGRES_USER=compass
# POSTGRES_PASSWORD=cambiar-esto
# POSTGRES_DB=compass
